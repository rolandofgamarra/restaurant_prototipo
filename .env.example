# Copiar a .env y completar. El archivo .env NUNCA se commitea.

# --- Django ---
DJANGO_SECRET_KEY=generar-uno-nuevo-con-secrets-token-urlsafe-50
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=src.config.settings.base
# El edge box habla con las cajas por LAN, sin certificado TLS propio (ADR 0001):
# en True relaja HTTPS/HSTS/cookies "secure". La nube (o cualquier despliegue con
# TLS real) deja esto en False. Ver src/config/settings/base.py.
DJANGO_LAN_SIN_TLS=False

# --- Base de datos ---
DATABASE_URL=postgres://restaurant:dev_only_never_in_production@localhost:5432/restaurant

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Identidad de esta instalacion ---
# Single-tenant: una instancia por cliente.
LOCAL_NOMBRE=Lomiteria Ejemplo
LOCAL_ZONA_HORARIA=America/Asuncion

# --- Terminal ---
# Cada caja tiene su propio identificador y su propio rango de numeracion.
# Dos terminales NUNCA comparten prefijo: es lo que evita colisiones en modo offline.
TERMINAL_ID=CAJA-01
TERMINAL_ESTABLECIMIENTO=001
TERMINAL_PUNTO_EXPEDICION=001

# --- Sincronizacion edge -> nube ---
SYNC_HABILITADO=False
SYNC_URL=
SYNC_TOKEN=

# --- Dinero ---
# Redondeo del vuelto al multiplo mas cercano, en guaranies.
REDONDEO_VUELTO_GS=100

# --- Politica de autorizacion ---
# Por encima de estos limites hace falta PIN de supervisor.
LIMITE_DESCUENTO_CAJERO_PCT=10
LIMITE_DESCUENTO_CAJERO_GS=20000

# --- Terceros ---
# No completar hasta tener la documentacion oficial en mano.
# Ninguna linea de estos modulos se escribe antes de eso.
BANCARD_ENTORNO=staging
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=
SIFEN_FACILITADOR_URL=
SIFEN_FACILITADOR_TOKEN=
