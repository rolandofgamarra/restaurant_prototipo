{
  "permissions": {
    "allow": [
      "Bash(make:*)",
      "Bash(uv run:*)",
      "Bash(uv sync:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(python manage.py makemigrations:*)",
      "Bash(python manage.py sqlmigrate:*)",
      "Bash(python manage.py check:*)",
      "Bash(docker compose:*)"
    ],
    "deny": [
      "Bash(git commit --no-verify:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./backups/**)"
    ]
  }
}
